      {
        tag: "table",
        id: "missileUpgradeRules",
        //`MissileWeapon.min(int lvl)`/`max(int lvl)` at tag v3.3.8 - the version this port's
        //missile module cites: base `min = 2*tier + lvl` and `max = 5*tier + tier*lvl`, each
        //overridden by the classes that rebalance themselves - ThrowingKnife `max = 6*tier +
        //(tier == 1 ? 2*lvl : tier*lvl)`, Bolas `min = 2*(tier-1) + 0*lvl` and
        //`max = 3*tier + (tier-1)*lvl`, Tomahawk `min = round(1.5*tier) + lvl` and
        //`max = round(4*tier) + (tier-1)*lvl`, HeavyBoomerang `max = 4*tier + (tier-1)*lvl`,
        //Shuriken `max = 4*tier + (tier == 1 ? 2*lvl : tier*lvl)`, Kunai/ThrowingClub
        //`max = 4*tier + tier*lvl`, ThrowingHammer `max = 4*tier + tier*lvl`. Both tables below are
        //derived from those formulas, so `minDamage + minPerLevel*lvl` is `min(lvl)` exactly. Before
        //2026-09-15 the rules table carried only the three starting missiles, so the twelve other
        //classes could not be thrown at all (nothing else read their damage).
        columns: "sourceClass:string|minPerLevel:number|maxPerLevel:number",
        children: [
          { tag: "row", sourceClass: "ThrowingStone", minPerLevel: 1, maxPerLevel: 1 },
          { tag: "row", sourceClass: "ThrowingKnife", minPerLevel: 1, maxPerLevel: 2 },
          { tag: "row", sourceClass: "ThrowingSpike", minPerLevel: 1, maxPerLevel: 1 },
          { tag: "row", sourceClass: "FishingSpear", minPerLevel: 1, maxPerLevel: 2 },
          { tag: "row", sourceClass: "ThrowingClub", minPerLevel: 1, maxPerLevel: 2 },
          { tag: "row", sourceClass: "Shuriken", minPerLevel: 1, maxPerLevel: 2 },
          { tag: "row", sourceClass: "ThrowingSpear", minPerLevel: 1, maxPerLevel: 3 },
          { tag: "row", sourceClass: "Kunai", minPerLevel: 1, maxPerLevel: 3 },
          { tag: "row", sourceClass: "Bolas", minPerLevel: 0, maxPerLevel: 2 },
          { tag: "row", sourceClass: "Javelin", minPerLevel: 1, maxPerLevel: 4 },
          { tag: "row", sourceClass: "Tomahawk", minPerLevel: 1, maxPerLevel: 3 },
          { tag: "row", sourceClass: "HeavyBoomerang", minPerLevel: 1, maxPerLevel: 3 },
          { tag: "row", sourceClass: "Trident", minPerLevel: 1, maxPerLevel: 5 },
          { tag: "row", sourceClass: "ThrowingHammer", minPerLevel: 1, maxPerLevel: 5 },
          { tag: "row", sourceClass: "ForceCube", minPerLevel: 1, maxPerLevel: 5 },
        ],
