[
  {
    tag: "game",
    schema: 0.1,
    children: [
      {
        tag: "trait",
        id: "actorFlags",
        name: "Mob.actorFlags",
        children: [
          {
            tag: "effect",
            apply_to: "flying",
            set: "bat,bee,elemental,newbornElemental,eye,swarm,ghost,spiritHawk,wraith,dustWraith",
          },
          {
            // `BlobImmunity`'s immunities list (`BlobImmunity.java`, tag `v3.3.8`): every
            // harmful *blob* in the game. Only two ported actors carry it - the spirit hawk
            // (`SpiritHawk.HawkAlly`) and the piranha (`Piranha`). The port's only
            // creature-facing blob is fire, so this set is read there.
            tag: "effect",
            apply_to: "blobImmune",
            set: "spiritHawk,piranha",
          },
          {
            tag: "effect",
            apply_to: "npc",
            set: "ghost,wandmaker,shopkeeper,blacksmith,imp,ratKing,impShopkeeper",
          },
          {
            tag: "effect",
            apply_to: "boss",
            // `Property.BOSS` holders at tag `v3.3.8`: the five chapter bosses plus
            // `YogFist` (all six declare it; `DwarfKing`/`YogDzewa` also declare
            // `BOSS_MINION` for their servants). Eye, Warlock and Pylon declare no
            // BOSS property - corrected 2026-09-19, when the suite first ran far
            // enough to check: an earlier pass had added all three, over-looting
            // them onto the 15-roll wealth tier.
            set: "goo,tengu,dm300,king,yog,yogFist",
          },
          {
            tag: "effect",
            apply_to: "miniboss",
            // `Property.MINIBOSS` holders at tag `v3.3.8` (unported CrystalGuardian/
            // FungalSentry/GnollSapper omitted): only `NewbornFireElemental` carries it
            // among the elementals, and Eye/Warlock declare neither BOSS nor MINIBOSS -
            // corrected 2026-09-19, when the suite first ran far enough to check: an
            // earlier pass had added plain Elemental, Eye and Warlock, over-looting
            // them onto the 5-roll wealth tier (Java gives all three the ordinary
            // single roll - `Mob.die()`: 15 for BOSS, 5 for MINIBOSS, else 1).
            set: "fetidRat,gnollTrickster,greatCrab,demonSpawner,pylon,rotHeart,rotLasher,newbornElemental",
          },
          {
            tag: "effect",
            apply_to: "undead",
            set: "king,ghoul,guard,monk,senior,necromancer,spectralNecromancer,ripperDemon,skeleton,necroSkeleton,thief,bandit,warlock,wraith,dustWraith",
          },
          {
            tag: "effect",
            apply_to: "demonic",
            // `YogDzewa$Larva` carries DEMONIC in Java (tag v3.3.8) like every other Yog
            // spawn; it was missing here, which also hid larvae from the demonic readers
            // (prismatic-light blind, starflower smite).
            set: "demonSpawner,eye,fetidRat,goo,mimic,crystalMimic,ripperDemon,scorpio,acidic,succubus,yog,yogFist,larva",
          },
          {
            tag: "effect",
            apply_to: "immovable",
            set: "dm201,sentry,rotHeart,rotLasher,pylon,demonSpawner,yog,blacksmith,ninjaLog",
          },
          // Java's `Char.Property.INORGANIC` members this port spawns (`Char.java`, v3.3.8 -
          // Wraith/CrystalGuardian/CrystalSpire are unported; dm201/necroSkeleton/armoredStatue
          // inherit it from DM200/Skeleton/Statue): immune to Bleeding/ToxicGas/Poison. The two
          // buffs ride `monsterStatusImmunities`; ToxicGas is a blob, so its site reads this set.
          {
            tag: "effect",
            apply_to: "inorganic",
            set: "dm100,dm200,dm201,dm300,golem,skeleton,necroSkeleton,statue,armoredStatue,pylon,wraith,dustWraith,ninjaLog",
          },
          {
            tag: "effect",
            apply_to: "never_sleeps",
            set: "fetidRat,gnollTrickster,greatCrab,demonSpawner,sentry,rotHeart,rotLasher,newbornElemental,pylon,wraith,dustWraith",
          },
        ],
      },
