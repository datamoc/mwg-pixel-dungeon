            tag: "row",
            // `Invulnerability.DURATION` (the blessed ankh's revive shield, tag `v3.3.8`).
            buff: "invulnerability",
            duration: 3,
          },
          {
            // `Feint.AfterImage.FeintConfusion` (`Feint.java`, tag `v3.3.8`): a `FlavourBuff`
            // Java applies for exactly 1 turn (`Buff.affect(enemy, FeintConfusion.class, 1)`),
            // wasting the whole of the attacker's next turn (`Mob.act()`'s early return while it
            // is up). This port's `advanceBuffs` decrements *before* the per-turn skip-turn gate
            // reads the value (see `takeMonsterTurn`'s `paralysis`/`frost` check), so a buff set
            // to Java's own "1" would already be gone by the time that gate runs on the
            // attacker's very next turn - 2 is what actually survives to be read once, then
            // expires the turn after, matching Java's single lost turn.
            tag: "row",
            buff: "feintConfusion",
            duration: 2,
          },
          {
            // `Talent.CounterAbilityTacker`: a bare 3-turn `FlavourBuff` `Feint.activate()` arms
            // on the hero when `COUNTER_ABILITY` is ranked (`Buff.prolong(hero, ..., 3f)`). Its
            // only real consumer is `afterAbilityUsed`'s post-spend refund (`gainCharge` of
            // `rank*0.375`, tracker detached with it) - a refund, not a discount. See
            // `PORT_COVERAGE.md`'s `Feint` row.
            tag: "row",
            buff: "counterAbility",
            duration: 3,
          },
          {
            // `Trap.HazardAssistTracker` (`levels/traps/Trap.java`, tag `v3.3.8`): a bare
            // `FlavourBuff` with `DURATION = 50f`, prolonged onto mobs by hazards (plants,
            // traps, the caves-boss wires) and read only by `Mob.die()` for the assist badge.
            // Neutral like every other `FlavourBuff` here, so it never wakes a sleeper.
            tag: "row",
            buff: "hazardAssist",
            duration: 50,
          },
          {
            // `Challenge.SpectatorFreeze` (`Challenge.java`, tag `v3.3.8`): the 10-turn
            // freeze the duel lays on every other non-ally, non-NPC char. Java also
            // `delayChar`s each spectator; this port folds that delay into the same
            // 10-turn action block (`takeMonsterTurn` skips frozen turns post-tick).
            tag: "row",
            buff: "spectatorFreeze",
            duration: 10,
          },
          {
            // `Challenge.DuelParticipant.DURATION`: the duel pair's own 10-turn clock,
            // ticked by the shared buff systems; the pairing/distance detach lives in
            // `tickDuelParticipant`, not in the duration.
            tag: "row",
            buff: "duelParticipant",
            duration: 10,
          },
          {
            // `Challenge.EliminationMatchTracker`: the 3-turn re-challenge discount
            // window Java arms on the hero when a duel ends with her alive.
            tag: "row",
            buff: "eliminationMatch",
            duration: 3,
          },
          {
            // `ElementalStrike.ElementalStrikeLuckyTracker`: Java never detaches it, so a
            // mob pays out Lucky-strike loot at most once per run. 9999 turns is the
            // catalogue's effectively-permanent stand-in (same as the other two rows
            // that use it), never rendered and never announced.
            tag: "row",
            buff: "luckyTracker",
            duration: 9999,
          },
          {
            // `PrismaticGuard` (`actors/buffs/PrismaticGuard.java`, tag `v3.3.8`): the
            // buff never expires on its own clock - it detaches when the image hatches
            // (`set(image)` converts an image back the same way). 9999 is the
            // catalogue's effectively-permanent stand-in (the cloak/focus precedent);
            // the scene re-arms it every hero turn regardless, Java's `spend(TICK)`
            // persistence. The value is never rendered: the status pane reads the
            // guard pool, not this duration.
            tag: "row",
            buff: "prismaticGuard",
            duration: 9999,
          },
          {
            // `HolyWeapon.HolyWepBuff.DURATION` / `HolyWard.HolyArmBuff.DURATION`
