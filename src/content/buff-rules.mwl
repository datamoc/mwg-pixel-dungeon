            tag: "row",
            buff: "smiteTracker",
            duration: 1,
          },
          {
            // `GuidingLight.GuidingLightPriestCooldown`: the Priest's 50-turn
            // free-cast gate (`FlavourBuff`, so the generic countdown/fade
