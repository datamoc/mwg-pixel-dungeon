[
  {
    tag: "game",
    schema: 0.1,
    children: [
      {
        tag: "trait",
        id: "statusImmunities",
        name: "Char.immunities",
        children: [
          {
            tag: "effect",
            apply_to: "fire",
            set: "burning",
          },
          {
            tag: "effect",
            apply_to: "magic",
            set: "charm,weakness,vulnerable,hex,degrade,magicalSleep",
          },
          {
            tag: "effect",
            apply_to: "chill",
            set: "chill",
          },
        ],
      },
      // Per-monster status immunities (`Char.isImmune()`'s mob half, tag `v3.3.8`): each row names
      // the port buff ids Java refuses to attach to that kind. Sources: the INORGANIC property
      // (bleeding/poison/toxicGas - the blob half is enforced at the toxic-gas site, not here),
      // the STATIC property (terror/amok/charm/paralysis/frost/chill - Sleep/Slow/Speed/Dread have
      // no port buff to gate), the ACIDIC property (ooze), FIERY on the burning fist (burning),
      // plus the instance lists - Succubus (charm), Tengu (roots/terror), Piranha (burning),
      // DM300's Sleep (no port buff; the drowsy path correctly still lands, since Java's
      // MagicalSleep is a different class). The bright fist carries no row: Java's
      // BrightFist declares no immunities (its ELECTRIC property only halves lightning
      // damage, which is the damage model's job, not this gate). `subtype` selects one
      // yogFistType; empty means every instance of the kind. Damage-source resistances (FIERY/
      // ELECTRIC/ICY/ACIDIC/Corrosion/Grim/Disintegration halving, `Char.resist()`'s 50%) are the
      // damage model's job (section 7), not this attachment gate - see PORT_COVERAGE.md.
      {
        tag: "table",
        id: "monsterStatusImmunities",
        columns: "monster:string|subtype:string|immunities:list",
        list_delimiter: ",",
        children: [
          { tag: "row", monster: "dm100", subtype: "", immunities: "bleeding,poison" },
          { tag: "row", monster: "dm200", subtype: "", immunities: "bleeding,poison" },
          { tag: "row", monster: "dm201", subtype: "", immunities: "bleeding,poison" },
          { tag: "row", monster: "dm300", subtype: "", immunities: "bleeding,poison" },
          { tag: "row", monster: "golem", subtype: "", immunities: "bleeding,poison" },
          { tag: "row", monster: "skeleton", subtype: "", immunities: "bleeding,poison" },
          { tag: "row", monster: "necroSkeleton", subtype: "", immunities: "bleeding,poison" },
          { tag: "row", monster: "statue", subtype: "", immunities: "bleeding,poison" },
          { tag: "row", monster: "armoredStatue", subtype: "", immunities: "bleeding,poison" },
          { tag: "row", monster: "pylon", subtype: "", immunities: "bleeding,poison,terror,amok,charm,paralysis,frost,chill" },
          { tag: "row", monster: "demonSpawner", subtype: "", immunities: "terror,amok,charm,paralysis,frost,chill" },
          { tag: "row", monster: "rotHeart", subtype: "", immunities: "terror,amok,charm,paralysis,frost,chill" },
          { tag: "row", monster: "yog", subtype: "", immunities: "terror,amok,charm,paralysis,frost,chill" },
          // NinjaLog (Smoke Bomb's BODY_REPLACEMENT decoy) adds Dread/Terror/Amok/Charm/Sleep and
          // Java's `AllyBuff` to its immunities, plus INORGANIC's bleeding/poison pair (wood is
          // organic, but the property is what drives the game logic). Dread and Sleep have no
          // buff id here (sleeping is a flag, not a buff) and `AllyBuff` has no analogue at
          // all, so the row carries what exists.
          { tag: "row", monster: "ninjaLog", subtype: "", immunities: "terror,amok,charm,bleeding,poison" },
          { tag: "row", monster: "goo", subtype: "", immunities: "ooze" },
          { tag: "row", monster: "acidic", subtype: "", immunities: "ooze" },
          { tag: "row", monster: "causticSlime", subtype: "", immunities: "ooze" },
          { tag: "row", monster: "yogFist", subtype: "rotting", immunities: "ooze" },
          { tag: "row", monster: "yogFist", subtype: "burning", immunities: "burning" },
          { tag: "row", monster: "yogFist", subtype: "rusted", immunities: "bleeding,poison" },
          { tag: "row", monster: "succubus", subtype: "", immunities: "charm" },
          { tag: "row", monster: "tengu", subtype: "", immunities: "roots,terror,blindness" },
          { tag: "row", monster: "piranha", subtype: "", immunities: "burning" },
          // `WandOfWarding.Ward`'s instance list (tag `v3.3.8`): Sleep, Terror, Dread, Vertigo and AllyBuff;
          // only Terror and Vertigo have port buff ids.
          { tag: "row", monster: "ward", subtype: "", immunities: "terror,vertigo" },
        ],
      },
    ],
  },
]
