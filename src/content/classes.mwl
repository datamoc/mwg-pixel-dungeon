[trait]
id=rogue
name=actors.hero.heroclass.rogue
[effect]
apply_to=weapon_key
set=port.name.dagger
[/effect]
[effect]
apply_to=damage_min
set=1
[/effect]
#Dagger overrides MeleeWeapon.max to `4*(tier+1) + lvl*(tier+1)` = 8 at tier 1, not the
#tier-1 base of 10 (same at v2.1.4 and v3.3.8; the 10 here was simply wrong).
[effect]
apply_to=damage_max
set=8
[/effect]
[effect]
apply_to=speed
set=1
[/effect]
[effect]
apply_to=accuracy
set=10
[/effect]
[effect]
apply_to=blurb_key
set=port.class.rogue.blurb
[/effect]
[effect]
apply_to=unlocked
set=false
[/effect]
[effect]
apply_to=ammo
set=true
[/effect]
[effect]
apply_to=badge
set=unlock_rogue
[/effect]
[effect]
apply_to=unlock_hint
set=port.class.rogue.unlockhint
[/effect]
[effect]
apply_to=special_kind
set=throw
[/effect]
[effect]
apply_to=special_label_key
set=items.weapon.missiles.throwingknife.name
[/effect]
[effect]
apply_to=special_ammo
set=3
[/effect]
[effect]
apply_to=special_damage_min
set=2
[/effect]
[effect]
apply_to=special_damage_max
set=6
[/effect]
[/trait]

