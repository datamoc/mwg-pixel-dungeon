[trait]
id=warrior
#SPD names a hero class through `HeroClass`'s own message key (`actors.hero.heroclass.<id>`),
#which every shipped language carries. The Cleric is the one exception: it postdates this
#checkout's HeroClass enum, so it keeps a port-owned name.
name=actors.hero.heroclass.warrior
[effect]
apply_to=weapon_key
set=port.name.wornshortsword
[/effect]
[effect]
apply_to=damage_min
set=1
[/effect]
[effect]
apply_to=damage_max
set=10
[/effect]
[effect]
apply_to=speed
set=1
[/effect]
[effect]
apply_to=accuracy
set=10
[/effect]
[effect]
apply_to=blurb_key
set=port.class.warrior.blurb
[/effect]
[effect]
apply_to=unlocked
set=true
[/effect]
[effect]
apply_to=ammo
set=true
[/effect]
[effect]
apply_to=badge
set=null
[/effect]
[effect]
apply_to=unlock_hint
set=
[/effect]
[effect]
apply_to=special_kind
set=throw
[/effect]
[effect]
apply_to=special_label_key
set=items.weapon.missiles.throwingstone.name
[/effect]
[effect]
apply_to=special_ammo
set=3
[/effect]
[effect]
apply_to=special_damage_min
set=2
[/effect]
[effect]
apply_to=special_damage_max
set=5
[/effect]
[/trait]

