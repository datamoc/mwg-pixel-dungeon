[item]
id=seedRotberry
#SPD names a seed through its plant's inner `Seed` class (`Rotberry.Seed`), so the real key is
#`plants.<plant>$seed.name` - not `items.seeds.<plant>.name`. Caught by tools/i18nCheck.ts, which
#renders an unresolvable key as the raw key text.
name=plants.rotberry$seed.name
slot=consumable
stackable=true
[/item]
