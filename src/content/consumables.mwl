# The alchemy catalogue's named outputs. Every item that exists as a real SPD class names itself
# through that class's own message key, so all 18 languages come for free. Only the four recipe
# outputs with no single SPD item class behind them - the scroll-to-stone conversion, the generic
# exotic potion/scroll results, and the EnhanceBomb recipe itself - fall back to `port.name.*`.
[item]
id=liquidMetal
name=items.liquidmetal.name
slot=consumable
stackable=true
