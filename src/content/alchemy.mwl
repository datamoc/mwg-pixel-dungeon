          {
            tag: "row",
            id: "potionSeed",
            ingredients: "seed:3",
            result: "potionHealing",
            resultQuantity: 1,
            energyCost: 0,
            requiresIdentified: false,
          },
          {
            tag: "row",
            id: "scrollToStone",
            ingredients: "scrollIdentify:1",
            result: "stoneOfIntuition",
            resultQuantity: 2,
            energyCost: 0,
            requiresIdentified: false,
          },
          {
            //`ExoticScroll.ScrollToExotic`: one regular scroll, cost 6. The authored
            //ingredients name `scrollMirror` only as a catalogue-valid representative
            //(the `Scroll.ScrollToStone` pattern above); the runtime transaction
            //(`craftScrollToExotic`) resolves the concrete scroll class, and only the
            //ported MirrorImage -> PrismaticImage pair is mapped there so far.
            tag: "row",
            id: "scrollToExotic",
            ingredients: "scrollMirror:1",
            result: "scrollPrismatic",
            resultQuantity: 1,
            energyCost: 6,
            requiresIdentified: false,
          },
          {
            //`ExoticPotion.PotionToExotic`: one regular potion, cost 4. The authored
            //ingredients name `potionInvis` only as a catalogue-valid representative
            //(the `Scroll.ScrollToStone` pattern above); the runtime transaction
            //(`craftPotionToExotic`) resolves the concrete potion class, and only the
            //ported Invisibility -> ShroudingFog pair is mapped there so far.
            tag: "row",
            id: "potionToExotic",
            ingredients: "potionInvis:1",
            result: "potionShrouding",
            resultQuantity: 1,
            energyCost: 4,
            requiresIdentified: false,
          },
