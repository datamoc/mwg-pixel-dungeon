[
  {
    tag: "game",
    schema: 0.1,
    children: [
      {
        tag: "table",
        id: "alchemyEnergy",
        columns: "kind:string|energy:number",
        children: [
          {
            tag: "row",
            kind: "seed",
            energy: 2,
          },
          {
            tag: "row",
            kind: "stone",
            energy: 3,
          },
          {
            tag: "row",
            kind: "scroll",
            energy: 6,
          },
          {
            //`ExoticScroll.energyVal()`: 6 over the regular counterpart (6 + 6).
            tag: "row",
            kind: "scrollPrismatic",
            energy: 12,
          },
          {
            tag: "row",
            kind: "potion",
            energy: 6,
          },
          {
            //`ExoticPotion.energyVal()`: 4 over the regular counterpart (6 + 4).
            tag: "row",
            kind: "potionShrouding",
            energy: 10,
          },
          //R080 (2026-09-29): the port's former `food` row (6) is gone - `Food` has no `energyVal()`
          //override in v3.3.8 (`items/food/Food.java` only defines `value()`), so it falls back to
          //`Item.energyVal()` = 0 and Java cannot scrap food for energy. The exact-id rows below
          //win over the kind rows above, one per class whose `energyVal()` differs from its base.
          //Seeds: `Plant.Seed` 2*q, `Rotberry.Seed`/`Starflower.Seed` 3*q (`plants/Rotberry.java:80`,
          //`Starflower.java:72`).
          { tag: "row", kind: "seedRotberry", energy: 3 },
          { tag: "row", kind: "seedStarflower", energy: 3 },
          //`StoneOfAugmentation`/`StoneOfEnchantment.energyVal()` = 5*q (base `Runestone` is 3*q).
          { tag: "row", kind: "stoneOfAugmentation", energy: 5 },
          { tag: "row", kind: "stoneOfEnchantment", energy: 5 },
          //`GooBlob`/`MetalShard.energyVal()` = 3*q (`items/quest/GooBlob.java:51`, `MetalShard.java:51`).
          { tag: "row", kind: "gooBlob", energy: 3 },
          { tag: "row", kind: "metalShard", energy: 3 },
          //`Elixir.energyVal()` = 12*q (`items/potions/elixirs/Elixir.java:43`); `ElixirOfHoneyedHealing`
          //overrides it with a flat 8 (`ElixirOfHoneyedHealing.java:78`). `featherFall` is an
          //`ElixirOfFeatherFall` at v3.3.8 (see R083), hence the Elixir value.
          { tag: "row", kind: "elixirArcaneArmor", energy: 12 },
          { tag: "row", kind: "elixirAquaticRejuvenation", energy: 12 },
          { tag: "row", kind: "elixirDragonsBlood", energy: 12 },
          { tag: "row", kind: "elixirIcyTouch", energy: 12 },
          { tag: "row", kind: "elixirMight", energy: 12 },
          { tag: "row", kind: "elixirToxicEssence", energy: 12 },
          { tag: "row", kind: "elixirHoneyedHealing", energy: 8 },
          { tag: "row", kind: "featherFall", energy: 12 },
          //`MagicalInfusion.energyVal()` = 12*q (`items/spells/MagicalInfusion.java:125`).
          { tag: "row", kind: "magicalInfusion", energy: 12 },
          //`UnstableBrew`/`UnstableSpell.energyVal()` = 8*q (`UnstableBrew.java:131`, `UnstableSpell.java:128`);
          //neither item is ported yet, the rows wait for them.
          { tag: "row", kind: "unstableBrew", energy: 8 },
          { tag: "row", kind: "unstableSpell", energy: 8 },
          {
            //`Brew.energyVal()`: every brew scraps for 12 (AquaBrew scales by
            //quantity over its 8-unit recipe, which has no port recipe yet).
            tag: "row",
            kind: "infernalBrew",
            energy: 12,
          },
          {
            tag: "row",
            kind: "blizzardBrew",
            energy: 12,
          },
          {
            tag: "row",
            kind: "shockingBrew",
            energy: 12,
          },
          {
            tag: "row",
            kind: "causticBrew",
            energy: 12,
          },
        ],
      },
      {
        tag: "table",
        id: "alchemyKnownEnergy",
        columns: "item:string|energy:number",
        children: [
          { tag: "row", item: "potionStrength", energy: 10 },
          { tag: "row", item: "potionExperience", energy: 10 },
          { tag: "row", item: "scrollUpgrade", energy: 10 },
          { tag: "row", item: "scrollTransmutation", energy: 10 },
        ],
      },
      {
        //Spells whose `energyVal()` is `(int)(base * (quantity / (float) Recipe.OUT_QUANTITY))`
        //(tag v3.3.8): the per-unit value is fractional, so the port evaluates it on the scrapped
        //quantity like Java does (one unit: truncated). `SummonElemental` has no override (0).
        tag: "table",
        id: "alchemyScrapRatio",
        columns: "item:string|base:number|outQuantity:number",
        children: [
          { tag: "row", item: "phaseShift", base: 12, outQuantity: 6 },
          { tag: "row", item: "recycle", base: 12, outQuantity: 12 },
          { tag: "row", item: "telekineticGrab", base: 10, outQuantity: 8 },
          { tag: "row", item: "curseInfusion", base: 12, outQuantity: 4 },
          { tag: "row", item: "reclaimTrap", base: 12, outQuantity: 5 },
          { tag: "row", item: "wildEnergy", base: 12, outQuantity: 5 },
          { tag: "row", item: "beaconOfReturning", base: 12, outQuantity: 5 },
        ],
      },
      {
        tag: "table",
        id: "alchemyRecipes",
