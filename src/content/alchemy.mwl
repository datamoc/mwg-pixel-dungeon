[
  {
    tag: "game",
    schema: 0.1,
    children: [
      {
        tag: "table",
        id: "alchemyEnergy",
        columns: "kind:string|energy:number",
        children: [
          {
            tag: "row",
            kind: "seed",
            energy: 2,
          },
          {
            tag: "row",
            kind: "stone",
            energy: 3,
          },
          {
            tag: "row",
            kind: "scroll",
            energy: 6,
          },
          {
            //`ExoticScroll.energyVal()`: 6 over the regular counterpart (6 + 6).
            tag: "row",
            kind: "scrollPrismatic",
            energy: 12,
          },
          {
            tag: "row",
            kind: "potion",
            energy: 6,
          },
          {
            //`ExoticPotion.energyVal()`: 4 over the regular counterpart (6 + 4).
            tag: "row",
            kind: "potionShrouding",
            energy: 10,
          },
          {
            // `ExoticPotion.energyVal()` (v3.3.8): regular potion 6 plus 4.
            tag: "row",
            kind: "potionShielding",
            energy: 10,
          },
          {
            tag: "row",
            //`Item.energyVal()` defaults to 0; `Food` does not override it.
            kind: "food",
            energy: 0,
          },
          {
            //`Brew.energyVal()`: every brew scraps for 12 (AquaBrew scales by
            //quantity over its 8-unit recipe, which has no port recipe yet).
            tag: "row",
            kind: "infernalBrew",
            energy: 12,
          },
          {
            tag: "row",
            kind: "blizzardBrew",
            energy: 12,
          },
          {
            tag: "row",
            kind: "shockingBrew",
            energy: 12,
          },
          {
            tag: "row",
            kind: "causticBrew",
            energy: 12,
          },
          //`StoneOfAugmentation`/`StoneOfEnchantment.energyVal()`: 5 * quantity.
          { tag: "row", kind: "stoneOfAugmentation", energy: 5 },
          { tag: "row", kind: "stoneOfEnchantment", energy: 5 },
          //`SeedOfRotberry` and `SeedOfStarflower.energyVal()`: 3 * quantity.
          { tag: "row", kind: "seedRotberry", energy: 3 },
          { tag: "row", kind: "seedStarflower", energy: 3 },
          //Quest items override Item.energyVal() with 3 * quantity.
          { tag: "row", kind: "gooBlob", energy: 3 },
          { tag: "row", kind: "metalShard", energy: 3 },
          //`Elixir.energyVal()`: 12 * quantity, including FeatherFall.
          { tag: "row", kind: "elixirArcaneArmor", energy: 12 },
          { tag: "row", kind: "elixirAquaticRejuvenation", energy: 12 },
          { tag: "row", kind: "elixirDragonsBlood", energy: 12 },
          { tag: "row", kind: "elixirIcyTouch", energy: 12 },
          { tag: "row", kind: "elixirMight", energy: 12 },
          { tag: "row", kind: "elixirHoneyedHealing", energy: 8 },
          { tag: "row", kind: "elixirToxicEssence", energy: 12 },
          { tag: "row", kind: "featherFall", energy: 12 },
          //`MagicalInfusion.energyVal()`: 12 * quantity. The unstable classes retain
          //their Java values even though their item families remain unported (R082).
          { tag: "row", kind: "magicalInfusion", energy: 12 },
          { tag: "row", kind: "unstableBrew", energy: 8 },
          { tag: "row", kind: "unstableSpell", energy: 8 },
        ],
      },
      {
        tag: "table",
        id: "alchemyScaledEnergy",
        columns: "item:string|total:number|outputQuantity:number",
        children: [
          //Spell energyVal() integer-scales against each recipe's OUT_QUANTITY.
          { tag: "row", item: "beaconOfReturning", total: 12, outputQuantity: 5 },
          { tag: "row", item: "curseInfusion", total: 12, outputQuantity: 4 },
          { tag: "row", item: "phaseShift", total: 12, outputQuantity: 6 },
          { tag: "row", item: "reclaimTrap", total: 12, outputQuantity: 5 },
          { tag: "row", item: "recycle", total: 12, outputQuantity: 12 },
          { tag: "row", item: "wildEnergy", total: 12, outputQuantity: 5 },
          { tag: "row", item: "telekineticGrab", total: 10, outputQuantity: 8 },
          { tag: "row", item: "alchemize", total: 4, outputQuantity: 8 },
        ],
      },
      {
        tag: "table",
        id: "alchemyScrapRatio",
        columns: "item:string|base:number|outQuantity:number",
        children: [
          //Quantity-aware spell scrap: (int)(base * quantity / OUT_QUANTITY),
          //mirroring alchemyScaledEnergy (no summonElemental row: no Java override).
          { tag: "row", item: "beaconOfReturning", base: 12, outQuantity: 5 },
          { tag: "row", item: "curseInfusion", base: 12, outQuantity: 4 },
          { tag: "row", item: "phaseShift", base: 12, outQuantity: 6 },
          { tag: "row", item: "reclaimTrap", base: 12, outQuantity: 5 },
          { tag: "row", item: "recycle", base: 12, outQuantity: 12 },
          { tag: "row", item: "wildEnergy", base: 12, outQuantity: 5 },
          { tag: "row", item: "telekineticGrab", base: 10, outQuantity: 8 },
          { tag: "row", item: "alchemize", base: 4, outQuantity: 8 },
        ],
      },
      {
        tag: "table",
        id: "alchemyKnownEnergy",
        columns: "item:string|energy:number",
        children: [
          { tag: "row", item: "potionStrength", energy: 10 },
          { tag: "row", item: "potionExperience", energy: 10 },
          { tag: "row", item: "scrollUpgrade", energy: 10 },
          { tag: "row", item: "scrollTransmutation", energy: 10 },
        ],
      },
      {
        tag: "table",
        id: "alchemyRecipes",
