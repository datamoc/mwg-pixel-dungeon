          { tag: "row", kind: "candle", frame: 466 },
          { tag: "row", kind: "embers", frame: 467 },
          { tag: "row", kind: "ankh", frame: 48 },
          { tag: "row", kind: "stylus", frame: 49 },
          // `ItemSpriteSheet.SEAL = MISC_CONSUMABLE + 2` (tag `v3.3.8`): stylus is +1 at 49.
          { tag: "row", kind: "brokenSeal", frame: 50 },
          { tag: "row", kind: "honeypot", frame: 53 },
          { tag: "row", kind: "alchemize", frame: 237 },
          { tag: "row", kind: "bag", frame: 480 },
          { tag: "row", kind: "sandBag", frame: 23 },
          // `ItemSpriteSheet.TORCH = MISC_CONSUMABLE + 3` (tag `v3.3.8`); MISC_CONSUMABLE is 48
          // (ankh 48, stylus 49 per the rows above), so 51 - not 480, which is the bag's frame.
          { tag: "row", kind: "torch", frame: 51 },
        ],
      },
