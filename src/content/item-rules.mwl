          { tag: "row", kind: "weapon", frame: 96 },
          { tag: "row", kind: "wand", frame: 208 },
          { tag: "row", kind: "food", frame: 437 },
          { tag: "row", kind: "seed", frame: 58 },
          // `ItemSpriteSheet.PETAL` (`UNCOLLECTIBLE` 35 + 4): the Dried Rose's own drop.
          { tag: "row", kind: "petal", frame: 39 },
          { tag: "row", kind: "darkGold", frame: 453 },
          { tag: "row", kind: "dwarfToken", frame: 454 },
          { tag: "row", kind: "amulet", frame: 61 },
          { tag: "row", kind: "ring", frame: 224 },
