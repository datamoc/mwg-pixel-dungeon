          { tag: "row", seed: "mageroyal", charge: 12 },
          { tag: "row", seed: "earthroot", charge: 40 },
          { tag: "row", seed: "starflower", charge: 40 },
          { tag: "row", seed: "fadeleaf", charge: 12 },
          { tag: "row", seed: "blindweed", charge: 12 },
        ],
