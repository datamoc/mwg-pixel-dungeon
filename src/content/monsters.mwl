  {
    tag: "monster",
    id: "yog",
    name: "actors.mobs.yogdzewa.name",
    // HP 400 is the port's deliberate balance scaling (Java: flat 1000 - see PORT_COVERAGE.md's
    // Yog row), and accuracy keeps Java's INFINITE_ACCURACY. Everything else here is Java's own
    // melee line (YogDzewa.java, v3.3.8: evasion 12, damage 15-25, armor 0-4 - the beam uses its
    // own 30-50/20-30 constants, never this row) and `maxLvl = -2`, which through
    // `exp = hero.lvl <= maxLvl ? EXP : 0` means Yog grants no experience - found, with the
    // King's and the fists' identical -2, by the 2026-09-15 audit.
    hp: 400,
    accuracy: 1000000,
    evasion: 12,
    damage_min: 15,
    damage_max: 25,
    armor_min: 0,
    armor_max: 4,
    experience: 50,
    max_level: -2,
    image: "assets/yog.png",
