<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A minimal WebView2 shell for the built game, so `dist/` can be shipped as a Windows
    executable instead of only as a web page.

    `mwg` documents desktop (WebView2) packaging as part of the framework, but its own host
    (`desktop/MwgDesktopHost` in its repository) is not part of the published npm package, and
    neither is anything else on that packaging path - so this project carries its own. The
    framework-side gap is recorded as P18 in `4MWG/IMPROVEMENT_PROPOSALS.md`; if a future `mwg`
    release ships a host or templates, this directory is what would be replaced by them.

    Pinned to an exact WebView2 version rather than a floating one: the release workflow restores
    on a clean runner, and a silently-newer SDK is not something a release build should pick up.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>MwgDesktopHost</AssemblyName>
    <RootNamespace>MwgDesktopHost</RootNamespace>
    <!-- The game ships as a folder (a self-contained `dotnet publish` for win-x64), so the target
         machine needs no .NET runtime of its own; WebView2 still comes from the Evergreen Runtime,
         which ships with Windows 11 and current Windows 10. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

</Project>
