# local garbage drawer: relocated clutter, one-off traces and retired notes.
# Never committed; moved here instead of deleted so nothing is lost.
# (tools/scratch/ stays the live scratch area for verify-script artifacts.)
/garbage/
node_modules/
dist/
tools/scratch/vlp.mjs
tools/scratch/*_dump.txt
tools/scratch/uiCheck.mjs
tools/scratch/i18nCheck.mjs
tools/scratch/*.py
.aider*
# esbuild output of the tools/scratch/*.ts helpers; regenerate with the command in each header
tools/scratch/dump-*.mjs
tools/scratch/find-invisible.mjs
tools/scratch/probe*.mjs
# session-local agent state (worktrees, replays, temp files)
.qwen/
# local notes (never committed)
notes/
# local proposals for the separate MWG framework repository
/4MWG/
# release packaging output (tools/pack-web.mjs, tools/pack-desktop.mjs); the release workflow
# builds these on a version tag and attaches them, so nothing here is committed
/release/
# Capacitor's Android platform project: generated by `npx cap add android` and regenerated in the
# release workflow, so it is not tracked. If this project ever has to customise the platform (a
# signing config, an asset-ignore pattern), that customisation moves into a tracked patch applied
# after `cap add` rather than being committed as a scaffold snapshot.
/android/
# desktop host build output
desktop/MwgDesktopHost/bin/
desktop/MwgDesktopHost/obj/
desktop/.publish-test/

# ACP client poll cursors (runtime state, written beside tools/ACP_client.py).
.poll_cursor_*.json
