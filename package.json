{
  "name": "spd-on-mwg",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Shattered Pixel Dungeon, ported onto the mwg framework. GPL-3.0-or-later, same as the game it ports.",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "npm run mwl:compile && tsc --noEmit && vite build && node tools/emit.mjs",
    "verify": "npm run check && npm run test:simulation && npm run test:items && npm run test:lua && npm run test:mwg && npm run test:settings && npm run test:ui && npm run test:bossunseal && npm run test:skeletonkey && npm run test:dropthrow && npm run test:cloak && npm run test:vertigo && npm run test:combo && npm run test:monk && npm run test:seal && npm run test:berserk && npm run test:corruption && npm run test:beacon && npm run test:mining && npm run build",
    "check": "npm run mwl:compile && tsc --noEmit && npm run i18n:verify && node tools/check-file-budget.mjs && node tools/audit-undefined.mjs",
    "mwl:compile": "node tools/compile-mwl.mjs",
    "test:simulation": "node tools/verifySimulation.mjs && node tools/verifyHiddenMimicContact.mjs && node tools/verifyRegeneration.mjs && node tools/verifyBanner.mjs && node tools/verifyVault.mjs && node tools/verifyBuffOverlays.mjs && node tools/verifyCrystalMine.mjs && node tools/verifyCrystalGuardianScale.mjs && node tools/verifyMindForm.mjs && node tools/verifyHeapStack.mjs && node tools/verifyRecycleTippedDart.mjs && node tools/verifyHermitCrabLoot.mjs && node tools/verifyAllyOrders.mjs",
    "test:items": "node tools/verifyItemWorkflows.mjs",
    "test:lua": "node tools/verifyLua.mjs",
    "test:mwg": "node tools/verifyMwgCompatibility.mjs",
    "test:settings": "node tools/verifyDisplaySettings.mjs",
    "test:ui": "node tools/verifyBagLayout.mjs",
    "test:beacon": "esbuild tools/verifyBeaconPush.ts --bundle --platform=node --format=esm --outfile=tools/scratch/verifyBeaconPush.mjs && node tools/scratch/verifyBeaconPush.mjs",
    "test:berserk": "esbuild tools/verifyBerserkRage.ts --bundle --platform=node --format=esm --outfile=tools/scratch/verifyBerserkRage.mjs && node tools/scratch/verifyBerserkRage.mjs",
    "test:seal": "esbuild tools/verifySealShield.ts --bundle --platform=node --format=esm --outfile=tools/scratch/verifySealShield.mjs && node tools/scratch/verifySealShield.mjs",
    "test:monk": "esbuild tools/verifyMonkEnergy.ts --bundle --platform=node --format=esm --outfile=tools/scratch/verifyMonkEnergy.mjs && node tools/scratch/verifyMonkEnergy.mjs",
    "test:combo": "esbuild tools/verifyCombo.ts --bundle --platform=node --format=esm --outfile=tools/scratch/verifyCombo.mjs && node tools/scratch/verifyCombo.mjs",
    "test:corruption": "esbuild tools/verifyWandCorruption.ts --bundle --platform=node --format=esm --outfile=tools/scratch/verifyWandCorruption.mjs && node tools/scratch/verifyWandCorruption.mjs",
    "test:vertigo": "esbuild tools/verifyVertigo.ts --bundle --platform=node --format=esm --outfile=tools/scratch/verifyVertigo.mjs && node tools/scratch/verifyVertigo.mjs",
    "test:cloak": "esbuild tools/verifyCloak.ts --bundle --platform=node --format=esm --outfile=tools/scratch/verifyCloak.mjs && node tools/scratch/verifyCloak.mjs",
    "test:dropthrow": "esbuild tools/verifyDropThrow.ts --bundle --platform=node --format=esm --outfile=tools/scratch/verifyDropThrow.mjs && node tools/scratch/verifyDropThrow.mjs",
    "test:skeletonkey": "esbuild tools/verifySkeletonKey.ts --bundle --platform=node --format=esm --outfile=tools/scratch/verifySkeletonKey.mjs && node tools/scratch/verifySkeletonKey.mjs",
    "test:bossunseal": "esbuild tools/verifyBossUnseal.ts --bundle --platform=node --format=esm --outfile=tools/scratch/verifyBossUnseal.mjs && node tools/scratch/verifyBossUnseal.mjs",
    "i18n": "node tools/i18n-extract.mjs",
    "i18n:check": "node tools/i18n-extract.mjs --check",
    "test:mining": "esbuild ./tools/verifyMiningBranch.ts --bundle --platform=node --format=esm --outfile=tools/scratch/verifyMiningBranch.mjs && node tools/scratch/verifyMiningBranch.mjs",
    "i18n:verify": "esbuild tools/i18nCheck.ts --bundle --platform=node --format=esm --outfile=tools/scratch/i18nCheck.mjs && node tools/scratch/i18nCheck.mjs",
    "parity:levelgen": "esbuild tools/levelgenParity.ts --bundle --platform=node --format=esm --outfile=tools/scratch/levelgenParity.mjs && node tools/scratch/levelgenParity.mjs",
    "assets": "node tools/extract-spd-assets.mjs",
    "mwg:check": "node tools/check-mwg-version.mjs",
    "release:web": "node tools/pack-web.mjs",
    "release:desktop": "node tools/pack-desktop.mjs",
    "android:add": "npx cap add android",
    "android:version": "node tools/stamp-android-version.mjs",
    "android:sync": "npx cap sync android",
    "android:apk": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "mwg": "npm:@datamoc/mw_games@^0.16.0",
    "pixi.js": "^8.20.1"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
