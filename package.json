{
  "name": "spd-on-mwg",
  "version": "0.2.3a",
  "private": true,
  "type": "module",
  "description": "Shattered Pixel Dungeon, ported onto the mwg framework. GPL-3.0-or-later, same as the game it ports.",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "npm run mwl:compile && tsc --noEmit && vite build && node tools/emit.mjs",
    "verify": "npm run check && npm run test:simulation && npm run test:items && npm run test:lua && npm run test:mwg && npm run test:settings && npm run test:ui && npm run test:bossunseal && npm run test:skeletonkey && npm run test:dropthrow && npm run test:cloak && npm run test:curseinfusion && npm run test:score && npm run test:beacon && npm run test:mining && npm run test:visual && npm run build",
    "browser:test": "node tools/browserTest.mjs",
    "check": "npm run mwl:compile && tsc --noEmit && npm run i18n:verify && node tools/check-file-budget.mjs && node tools/audit-undefined.mjs",
    "mwl:compile": "node tools/compile-mwl.mjs",
	"test:simulation": "node tools/verifySimulation.mjs && node tools/verifyHiddenMimicContact.mjs && node tools/verifyRegeneration.mjs && node tools/verifyBanner.mjs && node tools/verifyVault.mjs && node tools/verifyBuffOverlays.mjs && node tools/verifyCrystalMine.mjs && node tools/verifyCrystalGuardianScale.mjs && node tools/verifyMindForm.mjs && node tools/verifyHeapStack.mjs && node tools/verifyRecycleTippedDart.mjs && node tools/verifyHermitCrabLoot.mjs && node tools/verifyBlobCells.mjs && node tools/verifyMonsterRoster.mjs && esbuild ./tools/verifyVertigo.ts --bundle --platform=node --format=esm --outfile=tools/scratch/verifyVertigo.mjs && node tools/scratch/verifyVertigo.mjs && esbuild ./tools/verifyHeapBlastProof.ts --bundle --platform=node --format=esm --outfile=tools/scratch/verifyHeapBlastProof.mjs && node tools/scratch/verifyHeapBlastProof.mjs && node tools/verifyCursedWandTier.mjs && npm run test:lab-room && npm run test:dm300-phase",
	"test:lab-room": "esbuild ./tools/verifyLabRoomGate.ts --bundle --platform=node --format=esm --outfile=tools/scratch/verifyLabRoomGate.mjs && node tools/scratch/verifyLabRoomGate.mjs",
	"test:dm300-phase": "esbuild ./tools/verifyDM300Phase.ts --bundle --platform=node --format=esm --outfile=tools/scratch/verifyDM300Phase.mjs && node tools/scratch/verifyDM300Phase.mjs",
    "test:items": "node tools/verifyItemWorkflows.mjs",
    "test:lua": "node tools/verifyLua.mjs",
    "test:mwg": "node tools/verifyMwgCompatibility.mjs",
    "test:settings": "node tools/verifyDisplaySettings.mjs",
    "test:ui": "node tools/verifyBagLayout.mjs && node tools/verifyInterfaceMode.mjs",
    "test:beacon": "esbuild tools/verifyBeaconPush.ts --bundle --platform=node --format=esm --outfile=tools/scratch/verifyBeaconPush.mjs && node tools/scratch/verifyBeaconPush.mjs",
    "test:cloak": "esbuild tools/verifyCloak.ts --bundle --platform=node --format=esm --outfile=tools/scratch/verifyCloak.mjs && node tools/scratch/verifyCloak.mjs",
    "test:curseinfusion": "esbuild tools/verifyCurseInfusion.ts --bundle --platform=node --format=esm --outfile=tools/scratch/verifyCurseInfusion.mjs && node tools/scratch/verifyCurseInfusion.mjs",
    "test:score": "esbuild tools/verifyScore.ts --bundle --platform=node --format=esm --outfile=tools/scratch/verifyScore.mjs && node tools/scratch/verifyScore.mjs",
    "test:dropthrow": "esbuild tools/verifyDropThrow.ts --bundle --platform=node --format=esm --outfile=tools/scratch/verifyDropThrow.mjs && node tools/scratch/verifyDropThrow.mjs",
    "test:skeletonkey": "esbuild tools/verifySkeletonKey.ts --bundle --platform=node --format=esm --outfile=tools/scratch/verifySkeletonKey.mjs && node tools/scratch/verifySkeletonKey.mjs",
    "test:bossunseal": "esbuild tools/verifyBossUnseal.ts --bundle --platform=node --format=esm --outfile=tools/scratch/verifyBossUnseal.mjs && node tools/scratch/verifyBossUnseal.mjs",
    "i18n": "node tools/i18n-extract.mjs",
    "i18n:check": "node tools/i18n-extract.mjs --check",
    "test:mining": "esbuild ./tools/verifyMiningBranch.ts --bundle --platform=node --format=esm --outfile=tools/scratch/verifyMiningBranch.mjs && node tools/scratch/verifyMiningBranch.mjs",
    "test:visual": "node tools/verifyVisualParity.mjs",
    "screenshots:capture": "node tools/captureVisualBaseline.mjs",
    "screenshots:check": "node tools/compareScreenshots.mjs",
    "i18n:verify": "esbuild tools/i18nCheck.ts --bundle --platform=node --format=esm --outfile=tools/scratch/i18nCheck.mjs && node tools/scratch/i18nCheck.mjs",
    "parity:levelgen": "esbuild tools/levelgenParity.ts --bundle --platform=node --format=esm --outfile=tools/scratch/levelgenParity.mjs && node tools/scratch/levelgenParity.mjs",
    "test:parity": "esbuild tools/levelgenParity.ts --bundle --platform=node --format=esm --outfile=tools/scratch/levelgenParity.mjs && node tools/scratch/levelgenParity.mjs",
    "parity:combat": "esbuild tools/parityCombatTrace.ts --bundle --platform=node --format=esm --outfile=tools/scratch/parityCombatTrace.mjs && node tools/scratch/parityCombatTrace.mjs check",
    "assets": "node tools/extract-spd-assets.mjs",
    "mwg:check": "node tools/check-mwg-version.mjs",
    "release:web": "node tools/pack-web.mjs",
    "release:desktop": "node tools/pack-desktop.mjs",
    "android:add": "npx cap add android",
    "android:version": "node tools/stamp-android-version.mjs",
    "android:sync": "npx cap sync android",
    "android:apk": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@datamoc/mw_games": "^0.23.0",
    "mwg": "npm:@datamoc/mw_games@^0.23.0",
    "pixi.js": "^8.20.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
