{
  "name": "spd-on-mwg",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Shattered Pixel Dungeon, ported onto the mwg framework. GPL-3.0-or-later, same as the game it ports.",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node tools/emit.mjs",
    "check": "tsc --noEmit",
    "test:simulation": "node tools/verifySimulation.mjs",
    "test:items": "node tools/verifyItemWorkflows.mjs",
    "i18n": "node tools/i18n-extract.mjs"
  },
  "dependencies": {
    "mwg": "npm:@datamoc/mw_games@^0.4.0",
    "pixi.js": "^8.20.1"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
